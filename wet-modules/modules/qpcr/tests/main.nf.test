nextflow_process {

    name "Test Process QPCR"
    script "../main.nf"
    process "QPCR"

    tag "modules"
    tag "modules_wet"
    tag "qpcr"

    test("two samples, a no-template control, a positive control and an extraction blank") {

        when {
            process {
                """
                input[0] = record(id: 'P7', wells: [
                    record(row: 'A', column: 1, sample: 'S1', type: 'sample'),
                    record(row: 'B', column: 1, sample: 'S2', type: 'sample'),
                    record(row: 'C', column: 1, sample: 'NTC1', type: 'negative_control'),
                    record(row: 'E', column: 1, sample: 'POS1', type: 'positive_control'),
                    record(row: 'D', column: 1, sample: 'BLK1', type: 'blank')
                ])
                """
            }
        }

        then {
            def out = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert out.id == 'P7' },
                // provenance and log hold the device, times and session: only what the module promises
                { assert path(out.provenance).json.protocol == 'qpcr' },
                { assert path(out.provenance).json.state == 'done' },
                { assert path(out.log).exists() },
                { assert snapshot(path(out.result).json).match() }
            )
        }
    }
}
