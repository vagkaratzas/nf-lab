{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qpcr result",
  "description": "The program the plate went through, and each plate-map well's threshold cycle (Ct).",
  "type": "object",
  "required": [
    "plate",
    "program",
    "wells"
  ],
  "properties": {
    "plate": {
      "type": "string",
      "description": "The plate ID of the job"
    },
    "program": {
      "type": "object",
      "required": [
        "lid_temperature",
        "initial_denaturation_temperature",
        "initial_denaturation_s",
        "cycles",
        "denaturation_temperature",
        "denaturation_s",
        "annealing_temperature",
        "annealing_s",
        "extension_temperature",
        "extension_s",
        "final_extension_temperature",
        "final_extension_s",
        "hold_temperature",
        "volume_ul",
        "reverse_transcription_temperature",
        "reverse_transcription_s",
        "channel"
      ],
      "properties": {
        "lid_temperature": {
          "type": "number",
          "description": "°C"
        },
        "initial_denaturation_temperature": {
          "type": "number",
          "description": "°C"
        },
        "initial_denaturation_s": {
          "type": "integer",
          "description": "seconds"
        },
        "cycles": {
          "type": "integer"
        },
        "denaturation_temperature": {
          "type": "number",
          "description": "°C"
        },
        "denaturation_s": {
          "type": "integer",
          "description": "seconds"
        },
        "annealing_temperature": {
          "type": "number",
          "description": "°C"
        },
        "annealing_s": {
          "type": "integer",
          "description": "seconds"
        },
        "extension_temperature": {
          "type": "number",
          "description": "°C"
        },
        "extension_s": {
          "type": "integer",
          "description": "seconds"
        },
        "final_extension_temperature": {
          "type": "number",
          "description": "°C"
        },
        "final_extension_s": {
          "type": "integer",
          "description": "seconds"
        },
        "hold_temperature": {
          "type": "number",
          "description": "°C"
        },
        "volume_ul": {
          "type": "number"
        },
        "reverse_transcription_temperature": {
          "type": "number",
          "description": "°C"
        },
        "reverse_transcription_s": {
          "type": "integer",
          "description": "seconds"
        },
        "channel": {
          "enum": [
            "FAM",
            "HEX",
            "ROX",
            "Cy5"
          ]
        }
      },
      "additionalProperties": false
    },
    "wells": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/well"
          }
        ],
        "type": "object",
        "required": [
          "ct"
        ],
        "properties": {
          "ct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Threshold cycle; null: undetermined (no amplification)"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "well": {
      "type": "object",
      "required": [
        "row",
        "column",
        "sample",
        "type"
      ],
      "properties": {
        "row": {
          "type": "string",
          "pattern": "^[A-P]$"
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "sample",
            "negative_control",
            "positive_control",
            "blank"
          ]
        }
      }
    }
  }
}
