{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plate_weigh result",
  "description": "The plate's weight, and its plate-map wells.",
  "type": "object",
  "required": [
    "plate",
    "weight_g",
    "wells"
  ],
  "properties": {
    "plate": {
      "type": "string",
      "description": "The plate ID of the job"
    },
    "weight_g": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "wells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/well"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "well": {
      "type": "object",
      "required": [
        "row",
        "column",
        "sample",
        "type"
      ],
      "properties": {
        "row": {
          "type": "string",
          "pattern": "^[A-P]$"
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "sample",
            "negative_control",
            "positive_control",
            "blank"
          ]
        }
      }
    }
  }
}
