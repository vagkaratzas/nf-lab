// The tests need a device adapter to talk to: tests/run.sh starts one (fake backend).
plugins {
    id 'nf-lab@0.1.0'
}

// The Nextflow session is `-resume`d by nobody here: a test's plate IDs are unique per module.
nextflow.enable.strict = true

process {
    withLabel: 'process_wet' {
        executor = 'lab'
        time = null
        cpus = 1
        memory = 256.MB
        errorStrategy = { task.exitStatus in [69, 75] ? 'retry' : 'finish' }
        maxRetries = 2
    }
}
