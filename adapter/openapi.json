      },
      "State": {
        "type": "string",
        "enum": [
          "queued",
          "preflight",
          "running",
          "done",
          "failed_preflight",
          "failed_in_protocol",
          "stopped",
          "voided"
        ],
        "title": "State"
      },
      "SubmitRequest": {
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "title": "Capability",
            "examples": [
              "liquid-handling"
            ]
          },
          "queue": {
            "anyOf": [
              {
                "type": "string",
