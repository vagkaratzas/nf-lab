            "minItems": 1,
            "title": "Wells",
            "description": "One per filled well; kept in row, column order"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Params",
            "description": "The protocol's parameters (its module's input.schema.json): what the pipeline asks for. A param not given runs at the lab's or the binding's default. Unknown, wrong-typed or out-of-range params are refused (422). Part of the idempotency key",
            "examples": [
              {
                "duration_s": 120,
                "g": 500.0
              }
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "title": "Idempotency Key",
            "description": "hash(protocol, version, plate, wells in row, column order[, params by name]); one physical job"
          },
          "task_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Hash",
            "description": "The Nextflow task submitting (or collecting) the job: its hash, i.e. its work dir and its lineage id (lid://<hash>). Kept per job, outside the idempotency key"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "That task's Nextflow session (`-resume` keeps it): GET /jobs?session= lists every job it collected, failed attempts too"
          }
        },
