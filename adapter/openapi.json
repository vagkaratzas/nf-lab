{
  "openapi": "3.1.0",
  "info": {
    "title": "nf-labrobotics device adapter",
    "version": "0.1.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Submit",
        "description": "Queue a job for the capability's pool, or return the existing one for this idempotency key.",
        "operationId": "submit",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token (the adapter sets one)"
          },
          "200": {
            "description": "Key already in the ledger: the existing job, nothing new runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "No device offers this capability"
          },
          "409": {
            "description": "Key already used with a different payload"
          },
          "422": {
            "description": "A param is unknown, of the wrong type, out of range or other than the lab fixed; nothing was queued"
          }
        }
      },
      "get": {
        "summary": "Session Jobs",
        "description": "Every job a Nextflow session submitted or collected, every attempt (failures too), with the tasks\nthat collected it: each task hash is that task's lineage id. What `labctl report` writes.",
        "operationId": "session_jobs",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CollectedJob"
                  },
                  "title": "Response Session Jobs"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token (the adapter sets one)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Status",
        "description": "State, phase reached, stop boundary and device heartbeat.",
        "operationId": "status",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token (the adapter sets one)"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/lookup/{idempotency_key}": {
      "get": {
        "summary": "Lookup",
        "description": "Find a job after a head restart: the live job for the key, else its latest attempt.",
        "operationId": "lookup",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "idempotency_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token (the adapter sets one)"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/safe_stop": {
      "post": {
        "summary": "Safe Stop",
        "description": "Cancel while stoppable (counts as a pre-flight failure); after the boundary, let it finish.",
        "operationId": "safe_stop",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token (the adapter sets one)"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/release": {
      "post": {
        "summary": "Release",
        "description": "The finished plate is off the deck: unlock the device. Called by the person who unloads it. Idempotent.",
        "operationId": "release",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token (the adapter sets one)"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Job not finished yet, or failed in protocol or stopped and not resolved"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CollectedJob": {
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "title": "Capability",
            "examples": [
              "liquid-handling"
            ]
          },
          "queue": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue",
            "description": "Only the capability's devices in this queue may take the job (Nextflow's `queue` directive); None: any of them. Routing, not identity: outside the idempotency key",
            "examples": [
              "opentrons"
            ]
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "title": "Protocol"
          },
          "protocol_version": {
            "type": "string",
            "minLength": 1,
            "title": "Protocol Version"
          },
          "plate": {
            "type": "string",
            "minLength": 1,
            "title": "Plate",
            "description": "Plate ID from the plate map"
          },
          "wells": {
            "items": {
              "$ref": "#/components/schemas/Well"
            },
            "type": "array",
            "minItems": 1,
            "title": "Wells",
            "description": "One per filled well; kept in row, column order"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Params",
            "description": "The protocol's parameters (its module's input.schema.json): what the pipeline asks for. A param not given runs at the lab's or the binding's default. Unknown, wrong-typed or out-of-range params are refused (422). Part of the idempotency key",
            "examples": [
              {
                "duration_s": 120,
                "g": 500.0
              }
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "title": "Idempotency Key",
            "description": "hash(protocol, version, plate, wells in row, column order[, params by name]); one physical job"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt",
            "description": "1 + number of earlier attempts for this key (failed pre-flight or voided)"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id",
            "description": "The device that took the job; None while queued: the free device of the capability whose deck holds the plate takes it"
          },
          "program": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Program",
            "description": "What the protocol runs with: the binding's defaults, then the lab's, then `params`. Resolved when the job is queued; outside the idempotency key"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "stoppable": {
            "type": "boolean",
            "title": "Stoppable",
            "description": "True until the first liquid moves (the stop boundary)"
          },
          "stop_requested": {
            "type": "boolean",
            "title": "Stop Requested",
            "description": "safe_stop arrived after the stop boundary"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Why the job failed or stopped; who resolved or voided it, and why"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "Backend outputs, kept so a repeated submit can return them"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "released_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Released At"
          },
          "device_heartbeat_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Heartbeat At",
            "description": "Last time the device itself reported; stale = silent device"
          },
          "collected_by": {
            "items": {
              "$ref": "#/components/schemas/Collection"
            },
            "type": "array",
            "title": "Collected By",
            "description": "Every Nextflow task that submitted or collected this job"
          }
        },
        "type": "object",
        "required": [
          "capability",
          "protocol",
          "protocol_version",
          "plate",
          "wells",
          "idempotency_key",
          "job_id",
          "attempt",
          "device_id",
          "program",
          "state",
          "stoppable",
          "stop_requested",
          "reason",
          "result",
          "submitted_at",
          "started_at",
          "finished_at",
          "released_at",
          "device_heartbeat_at",
          "collected_by"
        ],
        "title": "CollectedJob"
      },
      "Collection": {
        "properties": {
          "task_hash": {
            "type": "string",
            "title": "Task Hash",
            "description": "Its work dir and lineage id: lid://<task_hash>"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          }
        },
        "type": "object",
        "required": [
          "task_hash",
          "session_id",
          "collected_at"
        ],
        "title": "Collection",
        "description": "A Nextflow task that submitted or collected the job (a retry, `-resume` or a fresh launch adds one)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
