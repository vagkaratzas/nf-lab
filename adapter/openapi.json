{
  "openapi": "3.1.0",
  "info": {
    "title": "nf-lab device adapter",
    "version": "0.1.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Submit",
        "description": "Queue a job, or return the existing one for this idempotency key.",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "200": {
            "description": "Key already in the ledger: the existing job, nothing new runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "No device offers this capability"
          },
          "409": {
            "description": "Key already used with a different payload"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Status",
        "description": "State, phase reached, stop boundary and device heartbeat.",
        "operationId": "status",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/lookup/{idempotency_key}": {
      "get": {
        "summary": "Lookup",
        "description": "Find a job after a head restart: the live job for the key, else its latest pre-flight failure.",
        "operationId": "lookup",
        "parameters": [
          {
            "name": "idempotency_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/safe_stop": {
      "post": {
        "summary": "Safe Stop",
        "description": "Cancel while stoppable (counts as a pre-flight failure); after the boundary, let it finish.",
        "operationId": "safe_stop",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/release": {
      "post": {
        "summary": "Release",
        "description": "Unlock the device once outputs are collected. Idempotent.",
        "operationId": "release",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Job not finished yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "title": "Capability",
            "examples": [
              "liquid-handling"
            ]
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "title": "Protocol"
          },
          "protocol_version": {
            "type": "string",
            "minLength": 1,
            "title": "Protocol Version"
          },
          "sample_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sample Ids"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "title": "Idempotency Key",
            "description": "hash(protocol version + sample IDs); one physical job"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt",
            "description": "1 + number of earlier pre-flight failures for this key"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "stoppable": {
            "type": "boolean",
            "title": "Stoppable",
            "description": "True until the first liquid moves (the stop boundary)"
          },
          "stop_requested": {
            "type": "boolean",
            "title": "Stop Requested",
            "description": "safe_stop arrived after the stop boundary"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Why the job failed or stopped"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "Backend outputs, kept so a repeated submit can return them"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "released_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Released At"
          },
          "device_heartbeat_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Heartbeat At",
            "description": "Last time the device itself reported; stale = silent device"
          }
        },
        "type": "object",
        "required": [
          "capability",
          "protocol",
          "protocol_version",
          "sample_ids",
          "idempotency_key",
          "job_id",
          "attempt",
          "device_id",
          "state",
          "stoppable",
          "stop_requested",
          "reason",
          "result",
          "submitted_at",
          "started_at",
          "finished_at",
          "released_at",
          "device_heartbeat_at"
        ],
        "title": "Job"
      },
      "State": {
        "type": "string",
        "enum": [
          "queued",
          "preflight",
          "running",
          "done",
          "failed_preflight",
          "failed_in_protocol",
          "stopped"
        ],
        "title": "State"
      },
      "SubmitRequest": {
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "title": "Capability",
            "examples": [
              "liquid-handling"
            ]
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "title": "Protocol"
          },
          "protocol_version": {
            "type": "string",
            "minLength": 1,
            "title": "Protocol Version"
          },
          "sample_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sample Ids"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "title": "Idempotency Key",
            "description": "hash(protocol version + sample IDs); one physical job"
          }
        },
        "type": "object",
        "required": [
          "capability",
          "protocol",
          "protocol_version",
          "sample_ids",
          "idempotency_key"
        ],
        "title": "SubmitRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
