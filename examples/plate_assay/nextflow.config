plugins {
    id 'nf-lab@0.1.0'
}

params.plate_map = "${projectDir}/../plate_transfer/plate_map.csv"

// Where labctl finds the device adapter. Set it in the launch shell to point elsewhere.
env.NF_LAB_ADAPTER = env('NF_LAB_ADAPTER') ?: 'http://127.0.0.1:8000'

process {
    // A failure (wet or dry) ends the run without stopping the machines: tasks already
    // started finish, nothing new starts.
    errorStrategy = 'finish'
    withLabel: 'process_wet' {
        executor = 'lab'
        // labctl only waits on the adapter: book little of this machine, and set no
        // time limit (it would count the adapter queue too, then kill mid-protocol).
        time = null
        cpus = 1
        memory = 256.MB
        // Retry pre-flight failures (75: no liquid moved) and an unreachable adapter (69).
        errorStrategy = { task.exitStatus in [69, 75] ? 'retry' : 'finish' }
        maxRetries = 2
    }
}
