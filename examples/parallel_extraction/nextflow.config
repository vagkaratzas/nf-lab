plugins {
    id 'nf-labrobotics@0.1.0'
}

params.plate_map = "${projectDir}/plate_map.csv"  // one plate: easy to follow in a demo

// How this run reaches the lab's device adapter (the lab executor hands these to labctl).
// Unset: the launch shell's NF_LAB_ADAPTER / NF_LAB_POLL / NF_LAB_GRACE, else labctl's defaults.
labrobotics {
    // Set to pin this pipeline to one adapter; unset, the launch shell's NF_LAB_ADAPTER wins
    // (validation and the dashboard demo point the examples at their own adapter that way).
    // adapter = 'http://127.0.0.1:8000'
    poll = 2.s
    grace = 5.m
}

// Lineage (Nextflow's provenance store, ./.lineage in the launch dir) is on: each task, its inputs and
// outputs. Opt out with `-c` a config that sets `lineage.enabled = false`.
lineage.enabled = true

process {
    // A failure (wet or dry) ends the run without stopping the machines: tasks already
    // started finish, nothing new starts.
    errorStrategy = 'finish'
    withLabel: 'process_wet' {
        executor = 'labrobotics'
        // labctl only waits on the adapter: book little of this machine, and set no
        // time limit (it would count the adapter queue too, then kill mid-protocol).
        time = null
        cpus = 1
        memory = 256.MB
        // Retry pre-flight failures (75: no liquid moved) and an unreachable adapter (69).
        errorStrategy = { task.exitStatus in [69, 75] ? 'retry' : 'finish' }
        maxRetries = 2
    }
    // Every task that calls the adapter (wet tasks, LAB_REPORT) runs on the lab executor, which gives it
    // the `labrobotics {}` settings, and gets the token, if the lab set one (`nextflow secrets set NF_LAB_TOKEN
    // <token>`). A secret never lands in the work dir; none: nothing sent.
    withLabel: 'process_wet|process_lab' {
        executor = 'labrobotics'
        secret = secrets.NF_LAB_TOKEN ? ['NF_LAB_TOKEN'] : []
    }
}
