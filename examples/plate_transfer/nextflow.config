plugins {
    id 'nf-lab@0.1.0'
}

params.plate_map = "${projectDir}/plate_map.csv"

// Where labctl finds the device adapter. Set it in the launch shell to point elsewhere.
env.NF_LAB_ADAPTER = env('NF_LAB_ADAPTER') ?: 'http://127.0.0.1:8000'

process {
    // A failure (wet or dry) ends the run without stopping the robots: tasks
    // already started finish, a robot mid-plate completes it, nothing new starts.
    errorStrategy = 'finish'
    withLabel: 'process_wet' {
        executor = 'lab'
        // Retry pre-flight failures (75: no liquid moved) and an unreachable
        // adapter (69: outcome unknown; the retry's same key asks the ledger).
        errorStrategy = { task.exitStatus in [69, 75] ? 'retry' : 'finish' }
        maxRetries = 2
        // Which of the lab's robots may take the job, like a Slurm partition
        // (e.g. 'opentrons'); unset: any robot with the step's capability.
        // queue = 'opentrons'
    }
}
