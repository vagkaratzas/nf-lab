plugins {
    id 'nf-labrobotics@0.1.0'
}

// Lineage (Nextflow's provenance store, ./.lineage in the launch dir) is on: each task, its inputs and
// outputs. Opt out with `-c` a config that sets `lineage.enabled = false`.
lineage.enabled = true

process {
    // A failure ends the run without stopping the robots: started tasks finish, nothing new starts.
    errorStrategy = 'finish'
    withLabel: 'process_wet' {
        executor = 'lab'
        errorStrategy = { task.exitStatus in [69, 75] ? 'retry' : 'finish' }
        maxRetries = 2
        cache = env('WET_CACHE') != 'false'  // checks/withlabel turns it off
        queue = env('WET_QUEUE')  // checks/routing: which robots may take the job
        secret = secrets.NF_LAB_TOKEN ? ['NF_LAB_TOKEN'] : []  // checks/auth: the adapter's token
    }
}
