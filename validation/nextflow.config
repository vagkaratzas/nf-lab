plugins {
    id 'nf-lab@0.1.0'
}

env.NF_LAB_ADAPTER = env('NF_LAB_ADAPTER') ?: 'http://127.0.0.1:8000'

process {
    // A failure ends the run without stopping the robots: started tasks finish, nothing new starts.
    errorStrategy = 'finish'
    withLabel: 'process_wet' {
        executor = 'lab'
        errorStrategy = { task.exitStatus in [69, 75] ? 'retry' : 'finish' }
        maxRetries = 2
        cache = env('WET_CACHE') != 'false'  // checks/withlabel turns it off
        queue = env('WET_QUEUE')  // checks/routing: which robots may take the job
    }
}
