# Criterion: the `lab {}` config scope reaches labctl through the lab executor and wins over
# the launch shell's NF_LAB_* (which every other check relies on when the scope is unset).
start_adapter
dead=http://127.0.0.1:9  # nobody listens
cat > lab.config <<CONFIG
lab {
    adapter = '$NF_LAB_ADAPTER'
}
CONFIG
NF_LAB_ADAPTER=$dead nf -c lab.config --plates 1
[[ $(sql "SELECT count(*) FROM jobs WHERE state = 'done'") == 1 ]]
# grace: an unreachable adapter exits 69 after 1 s, not labctl's default 5 min (three attempts; one plate, since a second plate's pending retry is dropped once the first gives up)
cat > dead.config <<CONFIG
lab {
    adapter = '$dead'
    grace = 1.s
}
CONFIG
SECONDS=0
fails nf -c dead.config --plates 1
(( SECONDS < 120 ))
[[ $(grep -lx 69 work/*/*/.exitcode | wc -l) == 3 ]]
