# examples/qpcr runs end to end on the fake backend: 1000 samples on 11 plates, RNA extraction spread
# over four liquid handlers, then RT-qPCR over six qPCR instruments; every plate's controls pass, so
# every sample gets a call in samples.csv.
NF_LAB_DEVICES=liquid-handling:4,qpcr:6 NF_LAB_STEP=0.1 start_adapter
"$NXF_CMD" -q run "$VALIDATION/../examples/qpcr" -ansi-log false -output-dir results
[[ $(sql "SELECT count(*) FROM jobs WHERE state = 'done' AND protocol = 'rna_extraction'") == 11 ]]
[[ $(sql "SELECT count(*) FROM jobs WHERE state = 'done' AND protocol = 'qpcr'") == 11 ]]
[[ $(sql "SELECT count(DISTINCT device_id) FROM jobs WHERE protocol = 'rna_extraction'") == 4 ]]  # all queued at once
[[ $(sql "SELECT count(DISTINCT device_id) FROM jobs WHERE protocol = 'qpcr'") -ge 4 ]]  # at least a wave's worth
# a plate's qPCR runs only after its extraction left the liquid handler
[[ $(sql "SELECT count(*) FROM jobs e JOIN jobs q ON e.plate = q.plate
          WHERE e.protocol = 'rna_extraction' AND q.protocol = 'qpcr' AND q.started_at < e.released_at") == 0 ]]
[[ $(tail -n +2 results/samples.csv | wc -l) == 1000 ]]
[[ $(grep -c invalid_plate results/samples.csv) == 0 ]]
[[ $(jq '.jobs | length' results/lab_report/lab_report.json) == 22 ]]
