# Criterion: two wet tasks on one device run serially, each locking it until release.
NF_LAB_STEP=0.3 start_adapter
nf --plates 2
[[ $(logged 'Submitted process > WET') == 2 ]]
[[ $(sql "SELECT count(*) FROM jobs WHERE state = 'done' AND released_at IS NOT NULL") == 2 ]]
# no overlap between one job's start and its release
[[ $(sql "SELECT count(*) FROM jobs a JOIN jobs b ON a.job_id < b.job_id
          WHERE a.started_at < b.released_at AND b.started_at < a.released_at") == 0 ]]
