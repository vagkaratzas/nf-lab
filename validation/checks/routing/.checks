# Criterion: the queue directive routes wet jobs to that queue's robots; without one,
# any robot of the capability takes them; a queue with no robot fails at once.
NF_LAB_DEVICES='liquid-handling/opentrons:1,liquid-handling/hamilton:1' start_adapter
WET_QUEUE=hamilton nf --plates 2
[[ $(sql "SELECT count(*) FROM jobs WHERE queue = 'hamilton' AND device_id = 'hamilton-1' AND state = 'done'") == 2 ]]
WET_QUEUE=tecan fails nf --plates 3
grep -q "no 'liquid-handling' device in queue 'tecan' runs protocol 'ok'" work/*/*/labctl.log
[[ $(sql "SELECT count(*) FROM jobs") == 2 ]]  # refused before the ledger
nf --plates 4 --protocol plate_transfer  # new keys, no queue
[[ $(sql "SELECT count(*) FROM jobs WHERE queue IS NULL AND state = 'done'") == 4 ]]
