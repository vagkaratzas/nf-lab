# Criterion: aborting the run safe-stops wet tasks; before the boundary nothing is consumed.
NF_LAB_STEP=1 start_adapter
nf_bg --plates 2
until_sql "SELECT count(*) = 1 FROM jobs WHERE state = 'preflight'"
kill -TERM $NF_PID  # what a dry-task failure or a scheduler kill does: Nextflow aborts the run
fails wait $NF_PID
[[ $(sql "SELECT count(*) FROM jobs WHERE state = 'failed_preflight' AND reason = 'safe_stop'") == 2 ]]
[[ $(cat work/*/*/labctl.log | grep -c 'signal 15: safe_stop') == 2 ]]
nf --plates 2 -resume  # attempt 2 of both, nothing consumed by attempt 1
[[ $(sql "SELECT group_concat(state) FROM (SELECT state FROM jobs WHERE attempt = 2)") == done,done ]]
