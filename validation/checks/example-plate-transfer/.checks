# examples/plate_transfer runs end to end on the fake backend over two robots:
# four plates, the wet step's per-well result reaches the dry report and samples.csv.
NF_LAB_DEVICES=2 start_adapter
"$NXF_CMD" -q run "$VALIDATION/../examples/plate_transfer" -ansi-log false -output-dir results
[[ $(sql "SELECT count(*) FROM jobs WHERE state = 'done'") == 4 ]]
[[ $(sql "SELECT count(DISTINCT device_id) FROM jobs") == 2 ]]
[[ $(tail -n +2 results/samples.csv | wc -l) == 26 ]]  # sample wells of the plate map
[[ $(cat results/reports/*.report.tsv | wc -l) == 33 ]]  # every filled well, controls and blanks too
# LAB_REPORT closes the run: every job of the session, each with the task that collected it
[[ $(jq '.jobs | length' results/lab_report/lab_report.json) == 4 ]]
[[ $(sql "SELECT count(*) FROM collections") == 4 ]]
for h in $(sql "SELECT task_hash FROM collections"); do [[ -d work/${h:0:2}/${h:2} ]]; done  # a work dir of this run
